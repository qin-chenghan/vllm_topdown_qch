# 当前执行的芯片目录：920b、950或hygon_c86_7490。
CHIP=920b

# 宿主机上的vLLM容器名称。
CONTAINER=corex5-v0.23.0

# 仓库在宿主机和容器内的共同路径。
PROJECT=/home/qch/tools/vllm_topdown

# 模型目录。
MODEL=/home/AgentDemo/Qwen/Qwen3-8B

# vLLM可执行文件及其Python解释器。
VLLM_BIN=vllm
PYTHON_BIN=python3

# vLLM安装目录；留空时由Python自动查找。
VLLM_SITE=

# 运行记录中的vLLM完整版本，以及最终文件名中的版本和模型简称。
VLLM_VERSION=0.23.0
MODEL_SHORT=qwen3
VLLM_VERSION_SHORT=0.23

# 使用vLLM V2 model runner。
VLLM_USE_V2_MODEL_RUNNER=1

# 天数平台图模式开关(2026-10-13): vLLM 0.23 + 天数需要显式 VLLM_ENFORCE_CUDA_GRAPH=1
# 才启用 CUDA graph, 否则静默跌回 eager -> decode 阶段 CPU 逐 token 跑全图, 0x0012 分支数暴涨。
VLLM_ENFORCE_CUDA_GRAPH=1
# 天数上 FULL/PIECEWISE 全图会炸(IXF.linear 被 dynamo skip), 只用 FULL_DECODE_ONLY。
# 950(A100)/hygon 留空则 vLLM 走自己默认(不受此影响)。
CUDA_GRAPH_COMPILATION='{"cudagraph_mode":"FULL_DECODE_ONLY","mode":0}'

# 使用的GPU编号。
# ⚠️ 0.23 适配(2026-09-22): 本套 topdown 端到端采集要求单 worker(TP=1)。
#   switch_pmu.py 通过 /collective_rpc 调用 configure_kperf, 并要求结果恰好 1 个 worker;
#   TP=4 会返回 4 个 worker 结果 → "This report requires one model execution worker"。
#   故这里固定单卡 + TP=1(与 KPERF_TOPDOWN.md 的 worker_set TP=DP=1 一致)。
GPU_ID=0

# API服务使用的模型名、监听地址、端口和健康检查路径。
SERVED_MODEL=qwen3-8b
SERVER_HOST=127.0.0.1
PORT=18026
HEALTH_ENDPOINT=/health

# vLLM服务端参数。
BLOCK_SIZE=16
# ⚠️ 0.23 适配(2026-09-22): 本采集要求 TP=1 → 单卡 32GB 装 Qwen3-8B(bf16 ~16GB)。
#   原 TP=4 时期为分摊 4 卡把 MAX_MODEL_LEN=16384 / BATCHED_TOKENS=163840 调大,
#   单卡下 KV cache 预留过大 → CUDA OOM(dispatch_unquantized_gemm)。
#   这里降到单卡可承受: MAX_MODEL_LEN 恰好覆盖负载(7000 输入 + 100 输出 + 余量),
#   并把 gpu_memory_utilization 降到 0.7 留出加载/forward 中间态余量。
MAX_MODEL_LEN=8000
MAX_NUM_SEQS=1
MAX_NUM_BATCHED_TOKENS=8000
TENSOR_PARALLEL_SIZE=1
DATA_PARALLEL_SIZE=1
DTYPE=bfloat16
GPU_MEMORY_UTILIZATION=0.7
PREFIX_CACHING_FLAG=--no-enable-prefix-caching
SERVER_SEED=0
SERVER_FLAGS="--async-scheduling"

# benchmark请求参数。
BENCH_BACKEND=openai
BENCH_ENDPOINT=/v1/completions
DATASET_NAME=random
RANDOM_INPUT_LEN=7000
RANDOM_OUTPUT_LEN=100
RANDOM_RANGE_RATIO=0
NUM_PROMPTS=1
NUM_WARMUPS=0
READY_CHECK_TIMEOUT_SEC=0
MAX_CONCURRENCY=1
REQUEST_RATE=1
IGNORE_EOS_FLAG=--ignore-eos
TEMPERATURE=0
BENCH_SEED=0

# 服务启动、退出和采集前后的等待参数，单位为秒。
READY_CHECK_ATTEMPTS=180
READY_CHECK_INTERVAL=2
SERVICE_SETTLE_SECONDS=2
PERF_SETTLE_SECONDS=1
SHUTDOWN_ATTEMPTS=30
SHUTDOWN_INTERVAL=1

# 热点每10万个用户态cycles采样一次；常驻采集使用Worker RPC确认的执行线程TID。
# 下列名称匹配仅用于不带session单独运行run_one.sh的原有流程。
HOTSPOT_WORKER_PATTERN="VLLM::Worker_TP"
PYTHON_PERF_SUPPORT=1
# ⚠️ 2026-09-28 临时: 三个 BTB REPLACE (uBTB 0x101a / fBTB 0x1021 / 主BTB 0x101c), 逗号分隔多事件同采
# 回退: cycles:u; 其它原事件: r8116/r8117(ind), r78/r79/r7a(spec)
PERF_EVENT=r1008
PERF_PERIOD=100000
PERF_REPORT_FLAGS="--stdio --no-children"
# 容器内真实 perf 二进制路径。
# ⚠️ 容器是 Ubuntu 24.04 且用容器 apt 装的 linux-tools(6.8), 但容器跑宿主 openEuler 5.10 内核,
#   /usr/bin/perf 是 wrapper (检测 5.10 找不到工具会拒绝工作), 必须直接用真实二进制:
#   /usr/lib/linux-tools/<版本>-generic/perf。用下面这段自动探测, 找不到再回退 /usr/bin/perf。
if [[ -z ${PERF:-} ]]; then
    # 用 glob 遍历探测容器内真实 perf 二进制, 避免 `ls ... | head -1`
    # 在 pipefail+set -e 下因 ls 找不到路径(宿主 source 时)以 exit 2 冒泡导致整个脚本退出。
    PERF=/usr/bin/perf
    for candidate in /usr/lib/linux-tools/*/perf; do
        [[ -e "$candidate" ]] || continue
        PERF=$candidate
        break
    done
    export PERF
fi

# 920B原始PMU事件组。
# cycles 0x0011
# inst_retired 0x0008
# inst_spec 0x001b
EVENTS_920B_TOPDOWN=0x0011,0x0008,0x2011,0x2012,0x001b
EVENTS_920B_FLUSH=0x0011,0x0010,0x2010,0x104f,0x200f
EVENTS_920B_BADSPEC_BRANCH=0x0010,0x1010,0x1013,0x1016,0x100d
EVENTS_920B_BACKEND_CORE=0x0011,0x7001,0x7002,0x7003,0x7004
EVENTS_920B_BACKEND_MEMORY=0x0011,0x7005,0x7006,0x7007,0x7008,0x7009
EVENTS_920B_ICACHE=0x0008,0x0001,0x0014,0x0027,0x0028,0x0011
EVENTS_920B_DCACHE=0x0008,0x0003,0x0004,0x0017,0x0016
EVENTS_920B_L3=0x0008,0x002a,0x002b
EVENTS_920B_TLB1=0x0008,0x0002,0x0026,0x0005,0x0025
EVENTS_920B_TLB2=0x0008,0x002d,0x002e,0x002f,0x0030,0x0011
EVENTS_920B_BRANCH=0x0008,0x0021,0x0022
EVENTS_920B_IMIX=0x001b,0x0070,0x0073,0x8005,0x0078
EVENTS_920B_IMIX2=0x001b,0x0071,0x0079,0x007a,0x0075,0x8006

# 分析 920B 分支预测、跳转相关事件
# 细分分支跳转指令
# br imm = 0x0078
# br imm% = 0x0078 / (0x0078 + 0x007a)
# br imm mis pred% = 0x8111 / (0x8110 + 0x8111)
# br ret = 0x0079
# br ret% = 0x0079 / (0x0078 + 0x007a)
# br ret mis pred% = 0x8115 / (0x8114 + 0x8115)
# br indnr = 0x007a - 0x0079
# br indnr = (0x007a - 0x0079) / (0x0078 + 0x007a)
# br indnr mis pred% = 0x8117 / (0x8116 + 0x8117)
# ═══ 精细化分支/BTB 事件组 (2026-09-26 新增, 端到端小范围采样) ═══
# 三组事件组自给(每组≤5事件, 组内算全部指标, 避免跨组相减噪声)。
# br imm = 0x0078; imm% = 0x0078/(0x0078+0x007a); imm mis% = 0x8111/(0x8110+0x8111)
EVENTS_BR_IMM=0x0078,0x007a,0x8110,0x8111
# br ret = 0x0079; ret% = 0x0079/(0x0078+0x007a); ret mis% = 0x8115/(0x8114+0x8115)
EVENTS_BR_RET=0x0079,0x0078,0x007a,0x8114,0x8115
# br indnr = 0x007a-0x0079; indnr% = (0x007a-0x0079)/(0x0078+0x007a); indnr mis% = 0x8117/(0x8116+0x8117)
EVENTS_BR_INDNR=0x007a,0x0079,0x0078,0x8116,0x8117

# br indnr mispred率较高，需要深入分析BTB

# 0x1002 0x101d 0x1003的分母
# 0x1000	IF_BP_PRED_BR	#of branches predicted by uBTB, vBTB, fBTB, BTB and static predictor

# high prio，BTB结尾的以0x1000为分母，其它的以BTB结尾的为分母，算出百分比
# 0x1002	IF_BP_PRED_BR_UBTB	#of predicted taken branches  hit by microBTB (uBTB) during speculative fetch. Note: if the same branch has been predicted in the same direction (without BP intra flush) by uBTB/VictimBTB/BTB, the choosing order is based on uBTB > fBTB > vBTB > BTB.
# 0x101a	IF_BP_UBTB_REPLACE	#of replace times for uBTB. Note: the replace means an old uBTB entry has been replaced by newly update entry.
# 0x101b	IF_BP_UBTB_CONFLICT	#of replace times due to the old uBTB entry and newly update entry with the same tag.
# 0x101d	IF_BP_PRED_BR_FBTB
# 0x1021	IF_BP_FBTB_REPLACE
# 0x1024	IF_BP_FBTB_MULTI_HIT
# 0x1003	IF_BP_PRED_BR_BTB	#of predicted taken branches hit by main BTB during speculative fetch.
# 0x101c	IF_BP_BTB_REPLACE	#of replace times for BTB due to capacity. Note: the replace means an old BTB entry has been replaced by newly update entry.
# 0x101f	IF_BP_BTB_MULTI_HIT	#of multi-hit occurs in the BTB and/or VictimBTB.

# 分析预测器未能提供任何预测的情况
# BR_PRED 0x0012, IF_BR_UNPRED_NTKN_SPEC 0x1008, IF_BR_UNPRED_TKN_SPEC 0x1009
# desired events:
# BP_NOT_PRED_BR=(0x1008+0x1009)/0x0012
# BR_UNPRED_NTKN_SPEC=0x1008/(0x1008+0x1009)
# BR_UNPRED_TKN_SPEC=0x1009/(0x1008+0x1009)
EVENTS_BP_NOT_PRED_BR=0x0012,0x1008,0x1009

# BR_PRED 0x0012, IF_BP_PRED_BR 0x1000, IF_BR_UNPRED_NTKN_SPEC 0x1008, IF_BR_UNPRED_TKN_SPEC 0x1009, BR_MIS_PRED 0x0010
# desired events:
# BP_PRED_BR=0x1000/0x0012
# BP_NOT_PRED_BR=(0x1008+0x1009)/0x0012
# BR_UNPRED_NTKN_SPEC=0x1008/(0x1008+0x1009)
# BR_UNPRED_TKN_SPEC=0x1009/(0x1008+0x1009)
# BR_MIS_PRED=0x0010/0x0012
BR_SPEC=0x0012,0x1000,0x1008,0x1009,0x0010

# BR_MIS_PRED 0x0010, IF_BP_MISP_BR_DIR 0x1004 , IF_BP_MISP_BR_RET 0x100d, IF_BP_MISP_BR_IND 0x1010, IF_BP_MISP_BR_BLR 0x1013, IF_BP_MISP_BR_BL, 0x1016, IF_BP_MISP_BR_TGT 0x1017, IF_BP_MISP_BR_LP 0x1019
# desired events:
# IF_BP_MISP_BR_DIR=0x1004/0x0010
# IF_BP_MISP_BR_RET=0x100d/0x0010
# IF_BP_MISP_BR_IND=0x1010/0x0010
# IF_BP_MISP_BR_BLR=0x1013/0x0010
# IF_BP_MISP_BR_BL=0x1016/0x0010
# IF_BP_MISP_BR_TGT=0x1017/0x0010
# IF_BP_MISP_BR_LP-0x1019/0x0010
BR_MIS_PRED1=0x0010,0x1004,0x100d,0x1010
BR_MIS_PRED2=0x0010,0x1013,0x1016,0x1017,0x1019

# IF_BP_PRED_BR 0x1000
# IF_BP_PRED_BR_SP 0x1001
# IF_BP_PRED_BR_UBTB 0x1002
# IF_BP_PRED_BR_BTB 0x1003
# IF_BP_PRED_BR_COND 0x1005
# IF_BP_PRED_BR_RET 0x100c
# IF_BP_PRED_BR_IND 0x100f
# IF_BP_PRED_BR_BLR 0x1012
# IF_BP_PRED_BR_BL 0x1015
# IF_BP_PRED_BR_LP 0x1018
# IF_BP_PRED_BR_FBTB 0x101d
# IF_BP_PRED_BR_VBTB 0x101e
# desired  events:
# IF_BP_PRED_BR_SP=0x1001/0x1000
# IF_BP_PRED_BR_UBTB=0x1002/0x1000
# IF_BP_PRED_BR_BTB=0x1003/0x1000
# IF_BP_PRED_BR_COND=0x1005/0x1000
# IF_BP_PRED_BR_RET=0x100c/0x1000
# IF_BP_PRED_BR_IND=0x100f/0x1000
# IF_BP_PRED_BR_BLR=0x1012/0x1000
# IF_BP_PRED_BR_BL=0x1015/0x1000
# IF_BP_PRED_BR_LP=0x1018/0x1000
# IF_BP_PRED_BR_FBTB=0x101d/0x1000
# IF_BP_PRED_BR_VBTB=0x101e/0x1000
IF_BP_PRED_BR1=0x1000,0x1001,0x1002,0x1003,0x1005
IF_BP_PRED_BR2=0x1000,0x100c,0x100f,0x1012,0x1015
IF_BP_PRED_BR3=0x1000,0x1018,0x101d,0x101e

# IF_BP_UBTB_REPLACE=0x101a/0x1002
# IF_BP_UBTB_CONFLICT=0x101b/0x1002
IF_BP_PRED_BR_UBTB=0x1002,0x101a,0x101b
# IF_BP_FBTB_REPLACE=0x1021/0x1002
# IF_BP_FBTB_MULTI_HIT=0x1024/0x1002
IF_BP_PRED_BR_FBTB=0x101d,0x1021,0x1024
# IF_BP_BTB_REPLACE=0x101c/0x1003
# IF_BP_BTB_MULTI_HIT=0x101f/0x1003
IF_BP_PRED_BR_BTB=0x1003,0x101c,0x101f

# BR_MIS_PRED是所有分支预测失败率，包括没被预测但跳转以及被预测但失败
# 不过当前已有数据中归在BR_MIS_PRED下的子项（IF_BP_MISP_BR_*）概念上都是被预测但失败的
# 而BR_UNPRED_TKN_SPEC无法被继续细分，看不出具体是由哪类分支跳转指令组成
# 因此为了计算完整的特定分支跳转指令的预测失败率，需要先计算其未被计算的量
# 拿IND为例：
# IF_BR_IND_SPEC 0x100e IND跳转指令总数
# IF_BP_PRED_BR_IND 0x100f 被预测的IND跳转指令总数
# IF_BP_MISP_BR_IND 0x1010 被预测的IND跳转指令预测失败总数
# 因此
# 0x100e-0x100f=没被预测的IND跳转指令总数
# 0x100e-0x100f+0x1010=IND跳转指令预测失败总数
# IF_BR_RET_SPEC 0x100b, IF_BP_PRED_BR_RET 0x100c, IF_BP_MISP_BR_RET 0x100d, BR_MIS_PRED 0x0010
# BR_MISP_RET/RET=(0x100b-0x100c+0x100d)/0x100b
# BR_MISP_RET/MISP=(0x100b-0x100c+0x100d)/0x0010
BR_MISP_RET=0x100b,0x100c,0x100d,0x0010
# IF_BR_IND_SPEC 0x100e, IF_BP_PRED_BR_IND 0x100f, IF_BP_MISP_BR_IND 0x1010, BR_MIS_PRED 0x0010
# BR_MISP_IND/IND=(0x100e-0x100f+0x1010)/0x100e
# BR_MISP_IND/MISP=(0x100e-0x100f+0x1010)/0x0010
BR_MISP_IND=0x100e,0x100f,0x1010,0x0010

# IF_BR_UNPRED_TKN_SPEC 0x1009
# BR_MISP_RET/UNPRED_TKN=(0x100b-0x100c)/0x1009
# BR_MISP_IND/UNPRED_TKN=(0x100e-0x100f)/0x1009
UNPRED_TKN_SUB=0x1009,0x100b,0x100c,0x100e,0x100f

