# Explicit placement is opt-in; empty legacy configurations remain supported.
COLLECTION_PROFILE=${COLLECTION_PROFILE:-full} # full or end_to_end
PLACEMENT_MODE=worker_set # legacy or worker_set; ⚠️ 2026-09-23 启用绑核
# ⚠️ 绑核方案(2026-09-23 实测拓扑): 容器 cpuset=80-159,240-319, mems=1,3 → 只能用 node1|node3。
#   node1 内每 cluster=4物理核(8逻辑, SMT成对): cluster10=80-87, cluster11=88-95, cluster12=96-103...
#   Worker pool = cluster10 的 4 个独立物理核(每核1逻辑CPU), Worker 绑 2 物理核。
WORKER_POOL_CPUS=80,82,84,86 # four physical cores, one logical CPU each (cluster10, node1)
WORKER_CPUS=80,82 # Worker 绑 2 物理核
WORKER_NUMA_NODE=1
SERVICE_CPUS=88,89 # API/EngineCore (cluster11, node1, 避开 pool 80-87)
CLIENT_CPUS=96,97 # benchmark 客户端 (cluster12, node1)
# legacy retains old whole-Worker / persistent execution-thread hotspot defaults.
HOTSPOT_SCOPE=${HOTSPOT_SCOPE:-legacy} # legacy, thread, worker

# Optional independent DevKit inference round (supported Arm servers only).
FREQUENCY_ENABLE=1
# 本地 DevKit-Tuner-CLI 26.0.RC1(aarch64), 已验证容器内可跑 devkit tuner turbostat。
DEVKIT_BIN=/home/l30070392/topdown/DevKit-Tuner-CLI-26.0.RC1-Linux-aarch64/devkit

# ⚠️ 0.23 适配(2026-09-22): 禁止持久 bench client。
#   scripts/bench_client.py 依赖较新 vLLM benchmark API(serve.prepare_benchmark),
#   容器 vLLM 0.23 的 vllm/benchmarks/serve.py 没有 prepare_benchmark → AttributeError。
#   这里设 0: 每轮直接用 0.23 原生 `vllm bench serve` CLI 对持久 service 发请求
#   (bench_client.py 的 0.26 拆分 API 在 0.23 不可用)。
PERSISTENT_BENCH_CLIENT=${PERSISTENT_BENCH_CLIENT:-0}

# A trusted task-specific configuration overrides defaults without editing history.
SPE_ENABLE=0 # 2026-09-23: worker_set 会自动触发 SPE(auto→1), 但我们只要 kperf topdown+绑核, 故强制 0
ROUND_WARMUPS=${ROUND_WARMUPS:-0}
WARMUP_SCOPE=${WARMUP_SCOPE:-per_group} # per_group or session
GROUP_START_TEMPERATURE=${GROUP_START_TEMPERATURE:-0} # 0 disables between-group cooling
if [[ -n ${TOPDOWN_CONFIG:-} ]]; then
    [[ "$TOPDOWN_CONFIG" != "${BASH_SOURCE[0]}" ]] || { printf 'Recursive config\n' >&2; exit 2; }
    source "$TOPDOWN_CONFIG"
fi
